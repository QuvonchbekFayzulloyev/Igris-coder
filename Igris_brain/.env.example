# ================================================================= #
# IGRIS BRAIN — MCP Server Configuration
# ================================================================= #
# Copy this file to .env and fill in your values
# All MCP servers read from this file for configuration
# ================================================================= #

# ---------------------------------------------------------------- #
# GitHub MCP Server
# ---------------------------------------------------------------- #
# Personal access token (repo, read:org, read:user scopes)
# Get one at: https://github.com/settings/tokens
# Or use: gh auth login (auto-detected)
GITHUB_TOKEN=

# ---------------------------------------------------------------- #
# Database MCP Server (PostgreSQL / MySQL)
# ---------------------------------------------------------------- #
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://localhost:5432/igris

# MySQL/MariaDB connection string (alternative)
# Format: mysql://user:password@host:port/database
# DATABASE_URL=mysql://root@localhost:3306/igris

# ---------------------------------------------------------------- #
# Database MCP Server (MongoDB)
# ---------------------------------------------------------------- #
# MongoDB connection string
# Format: mongodb://user:password@host:port/database
MONGODB_URL=mongodb://localhost:27017/igris

# ---------------------------------------------------------------- #
# Redis MCP Server
# ---------------------------------------------------------------- #
# Redis connection string
# Format: redis://:password@host:port/database
REDIS_URL=redis://localhost:6379/0

# Redis limits
WS_MAX_CONNECTIONS=100
WS_MAX_MESSAGE_SIZE=65536
WS_RATE_LIMIT=100

# ---------------------------------------------------------------- #
# WebSocket MCP Server
# ---------------------------------------------------------------- #
# Secret for WebSocket authentication (optional)
WS_SECRET=

# Connection limits
WS_MAX_CONNECTIONS=100
WS_MAX_MESSAGE_SIZE=65536
WS_RATE_LIMIT=100

# ---------------------------------------------------------------- #
# Web AI Bridge (Browser Automation)
# ---------------------------------------------------------------- #
# Chrome browser settings
WAB_HEADLESS=false
WAB_BROWSER_CHANNEL=chrome
WAB_CDP_ENABLED=true
WAB_CDP_URL=http://127.0.0.1:9222
WAB_CDP_PORT=9222

# Chrome user data (Windows)
WAB_CHROME_USER_DATA=C:/Users/user/AppData/Local/Google/Chrome/User Data
WAB_CHROME_PROFILE=Profile 1

# ---------------------------------------------------------------- #
# IGRIS Agent Settings
# ---------------------------------------------------------------- #
# LLM Model Configuration
IGRIS_MODEL=qwen3:8b
IGRIS_LLM_URL=http://localhost:11434
IGRIS_TEMPERATURE=0.2
IGRIS_MAX_TOKENS=8192

# ---------------------------------------------------------------- #
# OmniRoute Gateway (Multi-Provider LLM)
# ---------------------------------------------------------------- #
# OmniRoute — barcha LLM'larni bitta endpoint orqali ishlatish
# Setup: docker run -d -p 20128:20128 -p 20129:20129 diegosouzapw/omniroute:latest
# Dashboard: http://localhost:20129
OMNIROUTE_ENABLED=true
OMNIROUTE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
# Default model (OmniRoute format: provider/model)
# Examples: openai/gpt-4o, openai/gpt-4o-mini, anthropic/claude-3-5-sonnet, google/gemini-1.5-pro
OMNIROUTE_DEFAULT_MODEL=openai/gpt-4o-mini

# Memory Configuration
IGRIS_MEMORY_ENABLED=true
IGRIS_MEMORY_PATH=../Igris_Memory/brain_data

# Logging
IGRIS_LOG_LEVEL=INFO
IGRIS_LOG_FILE=logs/igris.log

# ---------------------------------------------------------------- #
# Security Settings
# ---------------------------------------------------------------- #
# API key for external services (if needed)
API_KEY=

# Webhook secret (if using webhooks)
WEBHOOK_SECRET=

# ---------------------------------------------------------------- #
# Development Settings
# ---------------------------------------------------------------- #
# Debug mode (set to true for verbose logging)
DEBUG=false

# Test mode
TESTING=false

# Auto-reload on code changes (development only)
RELOAD=false
