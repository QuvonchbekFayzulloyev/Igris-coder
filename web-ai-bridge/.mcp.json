{
  "mcpServers": {
    "bridge": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server/src/index.js"],
      "env": {
        "WAB_BROWSER_CHANNEL": "${user_config.browser_channel}",
        "WAB_HEADLESS": "${user_config.headless}",
        "WAB_PROFILE_DIR": "${user_config.profile_dir}",
        "WAB_CDP_ENABLED": "${user_config.cdp_enabled}",
        "WAB_CDP_URL": "${user_config.cdp_url}",
        "WAB_CDP_PORT": "${user_config.cdp_port}",
        "WAB_CHROME_USER_DATA": "${user_config.chrome_user_data}",
        "WAB_CHROME_PROFILE": "${user_config.chrome_profile}",
        "WAB_CHROME_EXECUTABLE": "${user_config.chrome_executable}",
        "WAB_DATA_DIR": "${CLAUDE_PLUGIN_DATA}",
        "NODE_PATH": "${CLAUDE_PLUGIN_DATA}/node_modules"
      }
    }
  }
}
