{
  "description": "web-ai-bridge: installs the bridge server's dependencies on first use and blocks obvious secrets from being typed into a third-party web AI chat.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/setup-deps.js"],
            "timeout": 180,
            "statusMessage": "Checking web-ai-bridge browser dependencies..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_web-ai-bridge_bridge__(browser_type|ask_web_ai|web_ai_start_research)",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/guard-secrets.js"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
