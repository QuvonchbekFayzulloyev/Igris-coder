{
  "id": "agent-config-001",
  "type": "config-agent",
  "identity": {
    "name": "Coder Agent",
    "version": "2.1.0"
  },
  "behavior": {
    "style": "step_by_step",
    "error_handling": "explicit",
    "communication": "concise"
